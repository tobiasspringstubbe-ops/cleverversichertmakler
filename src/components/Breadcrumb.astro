---
/** Brotkrumen für Unterseiten mit BreadcrumbList als strukturierte Daten. */
import { SITE_URL } from "../config";

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
const all: Crumb[] = [{ label: "Startseite", href: "/" }, ...items];
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: all.map((c, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: c.label,
    ...(c.href ? { item: new URL(c.href, SITE_URL).href } : {}),
  })),
};
---

<nav class="breadcrumb" aria-label="Brotkrumen">
  <ol class="breadcrumb__list">
    {
      all.map((c, i) => (
        <li class="breadcrumb__item">
          {c.href && i < all.length - 1 ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
        </li>
      ))
    }
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<style>
  .breadcrumb {
    margin-bottom: var(--space-4);
    font-size: 0.875rem;
    color: var(--ink-muted);
  }

  .breadcrumb__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .breadcrumb__item {
    max-width: none;
  }

  .breadcrumb__item + .breadcrumb__item::before {
    content: "/";
    margin-right: var(--space-2);
  }
</style>

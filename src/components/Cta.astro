---
/**
 * Handlungsaufruf „Erzähl uns von deinem Tier“, führt zum Kontaktformular
 * und trägt die Tierwahl als ?tier= mit. Quelle: BRIEF.md Abschnitt 4 und 7.
 */
import { href } from "../lib/url";

interface Props {
  variant?: "primary" | "secondary";
  /** Zusätzlicher Satz über dem Button. */
  lead?: string;
  class?: string;
  align?: "start" | "center";
}

const { variant = "primary", lead, class: className, align = "start" } = Astro.props;
---

<div class:list={["cta", `cta--${align}`, className]}>
  {lead && <p class="cta__lead">{lead}</p>}
  <a class:list={["button", `button--${variant}`]} href={href("/kontakt#anfrage")} data-species-link>
    Erzähl uns von deinem Tier
  </a>
</div>

<style>
  .cta {
    margin-top: var(--space-5);
  }

  .cta--center {
    text-align: center;
  }

  .cta__lead {
    margin-bottom: var(--space-3);
  }

  .cta--center .cta__lead {
    margin-inline: auto;
  }
</style>

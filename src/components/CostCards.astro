---
/**
 * Kostenkarten aus costs.json: alle drei Tierarten untereinander mit eigener
 * Überschrift, je drei Karten im Drei-Spalten-Raster, mobil eine Spalte.
 * Danach der GOT-Hinweis. Quelle: BRIEF.md Abschnitt 7; Anordnung nach
 * Vorgabe von Tobias (siehe TODO.md).
 */
import PlaceholderBadge from "./PlaceholderBadge.astro";
import { costs, species } from "../data";

const euro = (n: number) => n.toLocaleString("de-DE");
---

<div class="cost-cards">
  {
    species.map((s) => (
      <section class="cost-cards__group" aria-labelledby={`kosten-${s.id}`}>
        <h3 class="cost-cards__heading" id={`kosten-${s.id}`}>{s.name}</h3>
        <div class="cost-cards__grid">
          {costs.karten
            .filter((k) => k.tierart === s.id)
            .map((k) => (
              <article class="card cost-card">
                <h4 class="cost-card__title">{k.fall}</h4>
                <p class="cost-card__value">
                  {euro(k.von)} bis {euro(k.bis)} €
                  <PlaceholderBadge value={k.quelle} />
                </p>
                <p class="cost-card__note">{k.einordnung}</p>
              </article>
            ))}
        </div>
      </section>
    ))
  }
  <p class="cost-cards__got">
    {costs.got_hinweis}
    <PlaceholderBadge value={`TODO: ${costs.got_todo}`} />
  </p>
</div>

<style>
  .cost-cards__group + .cost-cards__group {
    margin-top: var(--space-6);
  }

  .cost-cards__heading {
    margin-bottom: var(--space-3);
  }

  .cost-cards__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  .cost-card {
    display: flex;
    flex-direction: column;
  }

  .cost-card__title {
    font-size: 1.0625rem;
    font-weight: 600;
    margin: 0 0 var(--space-2);
  }

  .cost-card__value {
    font-size: 1.375rem;
    font-weight: 700;
    margin-bottom: var(--space-2);
  }

  .cost-card__note {
    margin: 0;
    color: var(--ink-muted);
  }

  .cost-cards__got {
    margin-top: var(--space-5);
    font-size: 0.9375rem;
    color: var(--ink-muted);
  }

  @media (min-width: 600px) {
    .cost-cards__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>

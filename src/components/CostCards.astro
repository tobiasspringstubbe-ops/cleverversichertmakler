---
/**
 * Drei Kostenkarten der gewählten Tierart aus costs.json plus GOT-Hinweis.
 * Alle drei Sätze liegen im HTML; sichtbar ist nur der zur Tierart passende.
 * Wichtig: data-for sitzt auf einem Wrapper ohne eigene Layout-Stile, sonst
 * überschreibt ein scoped „display: grid“ das Ausblenden (siehe TODO.md).
 * Quelle: BRIEF.md Abschnitt 4 und 7.
 */
import PlaceholderBadge from "./PlaceholderBadge.astro";
import { costs, species } from "../data";

const euro = (n: number) => n.toLocaleString("de-DE");
---

<div class="cost-cards">
  {
    species.map((s) => (
      <div data-for={s.id}>
        <div class="cost-cards__grid">
          {costs.karten
            .filter((k) => k.tierart === s.id)
            .map((k) => (
              <article class="card cost-card">
                <h3 class="cost-card__title">{k.fall}</h3>
                <p class="cost-card__value">
                  {euro(k.von)} bis {euro(k.bis)} €
                  <PlaceholderBadge value={k.quelle} />
                </p>
                <p class="cost-card__note">{k.einordnung}</p>
              </article>
            ))}
        </div>
      </div>
    ))
  }
  <p class="cost-cards__got">
    {costs.got_hinweis}
    <PlaceholderBadge value={`TODO: ${costs.got_todo}`} />
  </p>
</div>

<style>
  .cost-cards__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  .cost-card {
    display: flex;
    flex-direction: column;
  }

  .cost-card__title {
    font-size: 1.0625rem;
    margin: 0 0 var(--space-2);
  }

  .cost-card__value {
    font-size: 1.375rem;
    font-weight: 700;
    margin-bottom: var(--space-2);
  }

  .cost-card__note {
    margin: 0;
    color: var(--ink-muted);
  }

  .cost-cards__got {
    margin-top: var(--space-5);
    font-size: 0.9375rem;
    color: var(--ink-muted);
  }

  @media (min-width: 600px) {
    .cost-cards__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>

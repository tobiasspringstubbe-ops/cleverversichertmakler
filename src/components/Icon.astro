---
/**
 * Icons als Inline-SVG, dekorativ (aria-hidden).
 * Hund, Katze, Pferd: gefüllte Silhouetten aus Phosphor Icons (MIT-Lizenz,
 * Copyright 2023 Phosphor Icons, https://phosphoricons.com), Vorgabe Tobias.
 * Alle anderen: eigene Linien-Icons, Strichstärke 2.2, runde Enden (BRIEF.md Abschnitt 3).
 */
import dogSvg from "@phosphor-icons/core/assets/fill/dog-fill.svg?raw";
import catSvg from "@phosphor-icons/core/assets/fill/cat-fill.svg?raw";
import horseSvg from "@phosphor-icons/core/assets/fill/horse-fill.svg?raw";

const pathOf = (svg: string): string => svg.match(/<path d="([^"]+)"/)?.[1] ?? "";
export type IconName =
  | "hund"
  | "katze"
  | "pferd"
  | "sprechblase"
  | "telefon"
  | "mail"
  | "info"
  | "haken"
  | "warnung"
  | "kreuz";

interface Props {
  name: IconName;
  class?: string;
  size?: number;
}

const { name, class: className, size } = Astro.props;

const filled: Partial<Record<IconName, string>> = {
  hund: pathOf(dogSvg),
  katze: pathOf(catSvg),
  pferd: pathOf(horseSvg),
};

const paths: Record<IconName, string> = {
  hund: filled.hund ?? "",
  katze: filled.katze ?? "",
  pferd: filled.pferd ?? "",
  sprechblase: "M20 15a2 2 0 0 1-2 2H9l-5 4V6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2z",
  telefon: "M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2",
  mail: "M4 6h16v12H4z M4 7l8 6 8-6",
  info: "M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18z M12 11v5 M12 8h.01",
  haken: "M5 12l5 5 9-10",
  warnung: "M12 4 2.5 20h19z M12 10v4 M12 17h.01",
  kreuz: "M6 6l12 12 M18 6 6 18",
};

const style = size ? `width:${size}px;height:${size}px` : undefined;
const isFilled = name in filled;
---

<svg
  class:list={["icon", { "icon--fill": isFilled }, className]}
  viewBox={isFilled ? "0 0 256 256" : "0 0 24 24"}
  aria-hidden="true"
  focusable="false"
  style={style}
  set:html={`<path d="${paths[name]}" />`}
/>

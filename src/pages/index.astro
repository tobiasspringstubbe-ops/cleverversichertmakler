---
import BaseLayout from "../layouts/BaseLayout.astro";
import { CLAIM } from "../config";
---

<BaseLayout>
  <section class="section">
    <div class="container">
      <h1>Für wen suchst du Schutz?</h1>
      <p class="muted">{CLAIM}</p>
      <p>Diese Seite entsteht gerade. Tierwahl, Kostenkarten, Tier-Kompass und Kontaktformular folgen in Schritt 3 bis 6 aus BRIEF.md.</p>
      <p>
        <a class="button button--primary" href="/kontakt">Erzähl uns von deinem Tier</a>
      </p>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import LegalBlock from "../components/LegalBlock.astro";
import PlaceholderBadge from "../components/PlaceholderBadge.astro";
import Cta from "../components/Cta.astro";
import { href } from "../lib/url";
---

<BaseLayout title="Erstinformation" description="Erstinformation nach § 15 VersVermV: wer wir sind, als was wir tätig sind, wie wir vergütet werden und an wen du dich bei Beschwerden wenden kannst." noindex>
  <section class="section">
    <div class="container prose">
      <Breadcrumb items={[{ label: "Erstinformation" }]} />
      <h1>Erstinformation</h1>
      <p>Diese Informationen bekommst du nach § 15 Versicherungsvermittlungsverordnung (VersVermV) beim ersten Geschäftskontakt. Du findest sie auch als <a href={href("/erstinformation.pdf")}>PDF zum Herunterladen</a> <PlaceholderBadge force />.</p>

      <LegalBlock
        title="Name und Anschrift"
        rows={[
          { label: "Firma", value: "TODO: Firma, Rechtsform" },
          { label: "Anschrift", value: "TODO: Straße, PLZ Ort" },
        ]}
      />
      <LegalBlock
        title="Tätigkeit"
        rows={[{ label: "Status", value: "TODO: Versicherungsmakler nach § 34d Abs. 1 GewO oder Versicherungsvertreter; ggf. Tätigkeit für die CLARUS AG, Augsburg" }]}
      />
      <LegalBlock
        title="Registrierung"
        rows={[
          { label: "Registernummer", value: "TODO: D-XXXX-XXXXX-XX" },
          { label: "Register", value: "Deutscher Industrie- und Handelskammertag (DIHK) e. V., Vermittlerregister", href: "https://www.vermittlerregister.info" },
          { label: "Erlaubnisbehörde", value: "TODO: zuständige IHK mit Anschrift" },
        ]}
      />
      <LegalBlock title="Beteiligungen" rows={[{ label: "Angaben nach § 15 VersVermV", value: "TODO: Beteiligungen über 10 % in beide Richtungen" }]} />
      <LegalBlock title="Vergütung">
        <p>Für die Vermittlung erhalten wir eine Courtage vom Versicherer. Sie ist im Beitrag enthalten; für dich entstehen keine zusätzlichen Kosten. <PlaceholderBadge force /></p>
      </LegalBlock>
      <LegalBlock title="Schlichtungsstellen">
        <ul>
          <li>Versicherungsombudsmann e. V., Postfach 08 06 32, 10006 Berlin <PlaceholderBadge force /></li>
          <li>Ombudsmann Private Kranken- und Pflegeversicherung, Postfach 06 02 22, 10052 Berlin <PlaceholderBadge force /></li>
        </ul>
      </LegalBlock>

      <Cta />
    </div>
  </section>
</BaseLayout>
